prefix=/workspace/static_gsl/linux
exec_prefix=/workspace/static_gsl/linux
libdir=/workspace/static_gsl/linux/lib
includedir=/workspace/static_gsl/linux/include
GSL_CBLAS_LIB=-lgslcblas

Name: GSL
Description: GNU Scientific Library
Version: 2.8
Libs: -L/workspace/static_gsl/linux/lib -lgsl ${GSL_CBLAS_LIB} -lm -lm 
Cflags: -I/workspace/static_gsl/linux/include
